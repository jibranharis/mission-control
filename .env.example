# Copy to .env.local for local dev, or add these in Vercel > Settings > Environment Variables.
# Every source is optional: anything left blank shows as NOT CONNECTED.
# Set to 1 to fill unconnected sources with sample data instead.
SAMPLE_DATA=

# Gate the whole dashboard behind a password (strongly recommended once deployed).
DASHBOARD_PASSWORD=

# Your time zone, used for "today" and the schedule.
TIMEZONE=America/Los_Angeles
OWNER_NAME=Jibran

# Storage for to-dos, notes, check-offs and pushed snapshots.
# Added automatically when you connect an Upstash Redis database in Vercel > Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Calendar (read and write) + Gmail (read-only), for any number of accounts.
# Create an OAuth client of type "Web application" with the redirect URI
# https://<your-app>/api/google/callback, set these two, then use
# Inbox > Connect a Google account once per account. Tokens are kept in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI if your app sits behind another domain.
GOOGLE_REDIRECT_URI=
# Legacy single account from `npm run google-auth` (read-only scopes; reconnect from the Inbox to edit events).
GOOGLE_REFRESH_TOKEN=

# Claude reads new mail to decide what's important and to spot dates. Without it, simple rules sort the mail.
ANTHROPIC_API_KEY=

# Canvas API. Token from Canvas > Account > Settings > New Access Token.
CANVAS_BASE_URL=https://canvas.ucdavis.edu
CANVAS_TOKEN=

# GitHub showcase: comma-separated logins; the token (fine-grained, read-only) adds private repos, PRs and commits.
GITHUB_USERS=jibranharis,z57333
GITHUB_TOKEN=

# Shared secret for POST /api/ingest/{claude,canvas}. Any long random string.
INGEST_TOKEN=
